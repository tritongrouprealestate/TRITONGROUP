# Triton Humming Valley — Apache config for cPanel.

# Never serve the credential file or the failed-lead log. config.php is
# executed rather than printed under normal conditions, but if PHP handling
# is ever broken or misconfigured the file would otherwise be served as plain
# text with the API key in it. leads.log and leads-failed.log hold
# enquirers' names, phone numbers and email addresses; the .log rule
# below is what keeps those off the public web.
<FilesMatch "^(config\.php|config\.sample\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# robots.txt is deliberately excluded: it is a .txt file that search
# engines must be able to read, and denying it stops the sitemap ever
# being found.
<FilesMatch "\.(log|md)$|^(?!robots\.txt$).*\.txt$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# A year-long cache would be wrong here: the filenames carry no fingerprint,
# so visitors would be stranded on an old design after an update.
#
# Photographs get one day. They are replaced by overwriting the file under
# the same name, and a longer lifetime means anyone who has already opened
# the page keeps seeing the previous picture. The site also appends ?v=BUILD
# to every image URL (see the top of js/site.js) — bumping that number in
# site.js makes a swap visible immediately, without waiting out the day.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/jpeg              "access plus 1 day"
  ExpiresByType image/png               "access plus 1 day"
  ExpiresByType image/svg+xml           "access plus 1 day"
  ExpiresByType text/html               "access plus 0 seconds"
  # The typefaces are the one thing here that will never change under the
  # same name, so they get the long cache the rest cannot have.
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# woff2 and jpeg are already compressed; running them through deflate costs
# CPU and saves nothing.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# Some cPanel hosts have no font/woff2 mapping, and a font served as
# application/octet-stream is refused with no error a visitor can see.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
